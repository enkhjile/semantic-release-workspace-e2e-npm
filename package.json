{
  "name": "semantic-release-workspace-e2e-npm",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.2.1",
  "workspaces": [
    "live/*"
  ],
  "scripts": {
    "acceptance": "node scripts/acceptance.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test scripts/consumer.test.mjs",
    "release:live": "semantic-release"
  },
  "devDependencies": {
    "semantic-release": "25.0.9",
    "semantic-release-workspace": "1.0.0-alpha.2"
  }
}
